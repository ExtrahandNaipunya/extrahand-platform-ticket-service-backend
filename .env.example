# Server
PORT=8001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/extrahand-support

# CORS — comma-separated allowed browser origins (frontend URLs)
# CORS_ORIGINS=http://localhost:3005,https://your-frontend.apps.example.com
# CORS_ORIGIN= (legacy single key; merged with CORS_ORIGINS)
# WEB_APP_URL=https://your-frontend.apps.example.com
# FRONTEND_URL=https://your-frontend.apps.example.com

# Default portal admin (seeded on startup if user does not exist)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=change-me-strong
# ADMIN_NAME=Support Admin
# ADMIN_ROLE=admin

# Redis (optional)
# REDIS_PORT=6379
